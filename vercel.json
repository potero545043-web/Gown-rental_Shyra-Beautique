{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/blob.js": {
      "maxDuration": 60
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/blob",
      "dest": "/api/blob.js"
    },
    {
      "src": "/(?!api/)(.*\\.(?:css|js|mjs|map|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot|otf|pdf|txt|xml|json|webmanifest|mp4|webm|mp3|wav|zip))$",
      "dest": "/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
